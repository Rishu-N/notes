// Cloudflare config: one Worker serves the Dump app (./web) AND its encrypted sync API (/v1/*).
// Cloudflare's GitHub integration runs `npx wrangler deploy` on every push to main.
{
  "name": "notes",
  "main": "sync-worker/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },
  // Notes storage: one strongly consistent Durable Object per sync space (free plan, SQLite-backed).
  "durable_objects": {
    "bindings": [{ "name": "NOTES", "class_name": "NoteBox" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["NoteBox"] }
  ],
  // Earlier storage. Kept only so notes already synced there are copied into the Durable Object.
  "kv_namespaces": [
    { "binding": "DUMP" }
  ]
}
