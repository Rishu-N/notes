// Cloudflare config: one Worker serves the Dump app (./web) AND its encrypted sync API (/v1/*).
// Cloudflare's GitHub integration runs `npx wrangler deploy` on every push to main.
{
  "name": "notes",
  "main": "sync-worker/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },
  // Storage for the encrypted notes. With no "id", Wrangler creates the namespace on first deploy.
  "kv_namespaces": [
    { "binding": "DUMP" }
  ]
}
